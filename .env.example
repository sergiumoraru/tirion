# Reference values only: no command automatically loads .env.example.
# Native commands never automatically load CWD .env files.
# Select a trusted absolute file with TIRION_ENV_FILE, or export variables.
# Existing process variables take precedence, including explicitly empty values.
# Standalone extraction helpers require exported variables or service-manager configuration.
# Local API settings (PORT and DATABASE_URL apply to tirion serve).
PORT=8080
TIRION_HOST=127.0.0.1
# Extra browser origins; replaces the development defaults. Empty = same-origin only.
# TIRION_ALLOWED_ORIGINS=https://tirion.example.com
# TIRION_ALLOWED_HOSTS=tirion.example.com
# Every API request needs the server token. Default file: ~/.tirion/api-token
# TIRION_API_TOKEN_FILE=/absolute/private/path/to/api-token
# Or supply TIRION_API_TOKEN through a secret manager, never committed here.
# Keep the backend on loopback behind an authenticated reverse proxy for shared use.
# Concurrency slots for graph reads (1-1024, default 16) and administrative
# operations such as index/fetch/checkout (1-64, default 2). When all slots are
# busy the API answers 503 BUSY. An invalid value stops tirion serve at startup.
# TIRION_MAX_CONCURRENT_READS=16
# TIRION_MAX_CONCURRENT_ADMIN=2
DATABASE_URL=postgres://localhost:5432/tirion?sslmode=disable

# MCP API origin; used by mcp-intel and mcp-guard.
# API URL should point to a running `tirion serve` instance.
TIRION_API_URL=http://localhost:8080
# CODEBASE_INTEL_API_URL is a legacy alias; prefer TIRION_API_URL.

# mcp-intel defaults and protected-deployment authentication.
TIRION_WORKSPACE=default-main
# TIRION_MCP_TIMEOUT_SECONDS=60
# TIRION_WORKDIR=/absolute/path/to/your/checkout
# Without TIRION_API_TOKEN(_FILE), clients read the local token file for any
# loopback TIRION_API_URL (any port); other origins must be HTTPS with an explicit token.
# Supply authentication outside git through your client's secret mechanism.
# TIRION_API_AUTH_HEADER takes precedence over Basic Auth username/password.
# mcp-guard uses the API token and explicit workdir too; see DOCS/mcp.md.

# Optional organization discovery during default-main nightly refresh.
# Unset: index existing repositories only. Supply gh authentication or GH_TOKEN
# outside git, with access to every listed organization.
# TIRION_GITHUB_ORGS="your-org another-org"

# Workspace API HTTPS GitHub fetches use GH_TOKEN, then GITHUB_TOKEN.
# Leave both unset to use Git's configured credentials instead (including
# per-repository identities). Supply tokens through protected runtime config,
# never in repository URLs. Other Git hosts and SSH use their own authentication.

# Workspace operations use the repository path recorded by indexing. An explicit
# clone root can recover stale paths after moving a deployment; no adjacent
# directories are searched automatically. REPOS_ROOT is a legacy fallback for that
# recovery and for scripts/nightly-refresh.sh (see SETUP.md#configuration-reference).
# TIRION_REPOS_ROOT=/absolute/path/to/repositories
# TIRION_WORKTREE_ROOT=/absolute/path/to/workspace-worktrees

# Optional absolute directory for configuration/state (default ~/.tirion).
# TIRION_HOME=/absolute/path/to/tirion-state

# Outbound proxy and certificate-trust settings (HTTPS_PROXY, HTTP_PROXY, NO_PROXY,
# ALL_PROXY in either case, SSL_CERT_FILE, SSL_CERT_DIR) are passed through to git
# and parser subprocesses when exported in the process environment. They are not
# loadable from TIRION_ENV_FILE. GIT_* overrides are never passed.
